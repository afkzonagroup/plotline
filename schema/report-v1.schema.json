{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afkzonagroup/plotline/schema/report-v1.schema.json",
  "title": "Plotline validation output (plotline validate --format json)",
  "type": "object",
  "required": ["generator", "ok", "files"],
  "additionalProperties": false,
  "properties": {
    "generator": { "type": "string", "pattern": "^Plotline [0-9]+\\.[0-9]+\\.[0-9]+ by AFKzona Group \\(https://afkzonagroup\\.lt\\)$" },
    "ok": { "type": "boolean", "description": "False when any file failed under --fail-on." },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "report"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "report": { "$ref": "#/$defs/report" }
        }
      }
    }
  },
  "$defs": {
    "report": {
      "type": "object",
      "required": ["generator", "format", "bytes", "ok", "summary", "issues", "plots", "notes"],
      "additionalProperties": false,
      "properties": {
        "generator": { "type": "string" },
        "format": { "enum": ["geojson", "kml", "csv"] },
        "bytes": { "type": "integer", "minimum": 0, "description": "Bytes of GeoJSON counted against the Information System limit." },
        "ok": { "type": "boolean", "description": "True when there are no errors." },
        "summary": {
          "type": "object",
          "required": ["errors", "warnings", "infos", "plots", "points", "polygons", "other", "positions", "producers", "hectares", "countries"],
          "additionalProperties": false,
          "properties": {
            "errors": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 },
            "infos": { "type": "integer", "minimum": 0 },
            "plots": { "type": "integer", "minimum": 0 },
            "points": { "type": "integer", "minimum": 0 },
            "polygons": { "type": "integer", "minimum": 0 },
            "other": { "type": "integer", "minimum": 0 },
            "positions": { "type": "integer", "minimum": 0 },
            "producers": { "type": "integer", "minimum": 0 },
            "hectares": { "type": "number", "minimum": 0 },
            "countries": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
          }
        },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
        "plots": { "type": "array", "items": { "$ref": "#/$defs/plot" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "issue": {
      "type": "object",
      "required": ["rule", "severity", "path", "feature", "message", "fixable", "line"],
      "additionalProperties": false,
      "properties": {
        "rule": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Rule id; see docs/rules.md." },
        "severity": { "enum": ["error", "warning", "info"] },
        "path": { "type": "string", "description": "JSON Pointer into the source (for KML and CSV, into the converted FeatureCollection); empty for the whole file." },
        "feature": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": "string" },
        "fixable": { "type": "boolean" },
        "line": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "plot": {
      "type": "object",
      "required": ["feature", "type", "positions", "hectares", "areaSource", "geometryValid", "bbox"],
      "additionalProperties": false,
      "properties": {
        "feature": { "type": "integer", "minimum": 0 },
        "type": { "enum": ["Point", "MultiPoint", "Polygon", "MultiPolygon", "GeometryCollection", null] },
        "positions": { "type": "integer", "minimum": 0 },
        "hectares": { "type": ["number", "null"] },
        "areaSource": { "enum": ["computed", "declared", "default", null] },
        "geometryValid": { "type": "boolean" },
        "bbox": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
          ]
        }
      }
    }
  }
}

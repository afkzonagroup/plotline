{
  "name": "@afkzona/plotline",
  "version": "0.1.0",
  "description": "Geolocation tooling for the EU Deforestation Regulation (EU) 2023/1115: validate, repair, measure and split plot GeoJSON for the EUDR Information System, offline.",
  "license": "AGPL-3.0-only",
  "author": "MB AFKzona Group",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afkzonagroup/plotline.git"
  },
  "homepage": "https://github.com/afkzonagroup/plotline#readme",
  "bugs": {
    "url": "https://github.com/afkzonagroup/plotline/issues"
  },
  "keywords": [
    "eudr",
    "deforestation",
    "regulation-2023-1115",
    "geojson",
    "geolocation",
    "traces",
    "due-diligence",
    "offline"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "plotline": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/report-v1.json": "./schema/report-v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "schema/",
    "LICENSE",
    "LICENSE-ADDITIONAL-TERMS.md",
    "COMMERCIAL.md",
    "TRADEMARKS.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-app.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
